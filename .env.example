# -----------------------------------------------------------------
#  PetQR — Variables de entorno (PLANTILLA OFICIAL)
# -----------------------------------------------------------------

# Base de datos (SQLite para desarrollo local)
DATABASE_URL=sqlite:///database.db

# Flask
FLASK_APP=src/app.py
FLASK_APP_KEY="cambia-esto-por-una-clave-secreta"
FLASK_DEBUG=1
DEBUG=TRUE

# JWT — clave secreta para firmar los tokens de autenticación
JWT_SECRET_KEY="cambia-esto-por-una-clave-segura"

# Cloudinary — para subir imágenes de mascotas
# Pega aquí tus credenciales del panel de Cloudinary con este formato:
CLOUDINARY_URL=cloudinary://TU_API_KEY:TU_API_SECRET@TU_CLOUD_NAME

# Front-End
VITE_BASENAME=/

# URL del Backend en Render (Servidor de producción oficial)
VITE_BACKEND_URL=https://sample-service-name-im03.onrender.com